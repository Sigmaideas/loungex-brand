# 의존성
node_modules/

# 환경 변수 (API 키 포함 — 절대 커밋 금지)
.env
.env.local
.env.*.local

# 수집된 데이터: 원본 reviews.json 은 비공개, 요약 summary.json 만 공개 (대시보드 표시용)
data/*
!data/summary.json
!data/summary-google.json
!data/summary-app.json
!data/summary-kakao.json
!data/rank.json
!data/trend.json
# 뉴스는 공개 기사라 원문째로 커밋 — 커밋 파일 자체가 누적 저장소 역할(캐시 불필요)
!data/news.json
# 유튜브·블로그 언급도 같은 이유로 커밋 (공개 게시물 + 누적 저장소)
!data/youtube.json
!data/blog.json
# 자동 답글 캐시: 생성된 답글을 빌드 간 보존하려고 커밋 (원본 reviews 는 여전히 비공개)
!data/reply-cache.json
!data/reply-cache-google.json
!data/reply-cache-app.json
!data/reply-cache-kakao.json

# 시스템/에디터
.DS_Store
*.log
.vscode/
.idea/

# 테스트/임시 산출물
.playwright-mcp/
*.png
!logo.png
.claude/
